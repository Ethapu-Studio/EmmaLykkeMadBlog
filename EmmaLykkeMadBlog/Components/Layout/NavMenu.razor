<header class="site-header">
    <div class="header-top">
        <a class="brand" href="/" aria-label="Emma Lykke – forside">
            <span class="brand-name">Emma Lykke</span>
            <span class="brand-sub">Aut. klinisk diætist</span>
        </a>

        <nav class="main-nav" aria-label="Hovednavigation">
            <ul>
                <li class="has-dropdown">
                    <a href="#" aria-haspopup="true">Opskrifter <span class="caret" aria-hidden="true">▾</span></a>
                    <ul class="dropdown">
                        @* TODO: Replace static categories with API data. *@
                        <li><a href="#">Morgenmad</a></li>
                        <li><a href="#">Snacks</a></li>
                        <li><a href="#">Aftensmad</a></li>
                        <li><a href="#">Bagning</a></li>
                    </ul>
                </li>
                <li><a href="#">Om</a></li>
                <li><a href="#">Kontakt</a></li>
            </ul>
        </nav>

        <div class="header-utility">
            <AuthorizeView>
                <Authorized>
                    <details class="account">
                        <summary class="account-trigger">
                            <span class="account-name">@context.User.Identity?.Name</span>
                            <span class="caret" aria-hidden="true">▾</span>
                        </summary>
                        <ul class="account-menu">
                            @* TODO: add <li><a href="/profil">Min profil</a></li> when profiles exist *@
                            <li>
                                <form method="post" action="/auth/logout">
                                    <AntiforgeryToken />
                                    <button type="submit">Log ud</button>
                                </form>
                            </li>
                        </ul>
                    </details>
                </Authorized>
                <NotAuthorized>
                    <a class="login-link" href="/login" data-auth-open="login" aria-haspopup="dialog">Log ind</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

<style>
    .header-top { position: relative; }

    .header-utility { position: absolute; top: 1rem; right: var(--gutter); }

    .header-utility a,
    .account-trigger {
        display: inline-block;
        padding: .6rem 0;
        color: var(--color-primary);
        font-size: .8rem;
        font-weight: 600;
        letter-spacing: .1em;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
    }

    .account { position: relative; }
    .account-trigger { display: flex; gap: .4rem; list-style: none; }
    .account-trigger::-webkit-details-marker { display: none; }

    .account-name {
        max-width: 10rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .account-menu form { margin: 0; }

    .account-menu {
        position: absolute;
        right: 0;
        top: 100%;
        min-width: 10rem;
        margin: 0;
        padding: .5rem 0;
        list-style: none;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 4px;
    }

    .account-menu button {
        width: 100%;
        padding: .6rem 1rem;
        border: 0;
        background: none;
        font: inherit;
        text-align: left;
        cursor: pointer;
    }

    @@media (max-width: 700px) {
        .header-top { padding-top: 2.75rem; }
        .header-utility { top: .25rem; }
    }
</style>